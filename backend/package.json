{
  "name": "mi-escuela-primero-backend",
  "version": "1.0.0",
  "description": "Backend API for MiEscuelaPrimero — Mexicanos Primero Jalisco initiative",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"*.js\"",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "db:init": "node db/init.js",
    "db:migrate": "node -e \"require('./db/init').runMigrations()\"",
    "db:seed": "node -e \"require('./db/init').runSeeds()\"",
    "db:reset": "node -e \"require('./db/init').resetDatabase()\"",
    "db:verify": "node -e \"require('./db/init').verifyConnection()\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "papaparse": "^5.4.1",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/**"
    ],
    "testPathPattern": "tests/",
    "setupFilesAfterFramework": [
      "./tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
