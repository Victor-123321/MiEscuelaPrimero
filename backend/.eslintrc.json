{
  "extends": ["airbnb-base"],
  "env": {
    "node": true,
    "es2020": true,
    "jest": true
  },
  "rules": {
    "no-console": "warn",
    "import/no-extraneous-dependencies": ["error", { "devDependencies": ["tests/**/*.js"] }],
    "no-underscore-dangle": "off",
    "consistent-return": "off",
    "no-param-reassign": ["error", { "props": false }]
  },
  "ignorePatterns": ["node_modules/", "coverage/"]
}
