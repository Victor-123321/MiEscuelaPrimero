# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mi_escuela_primero
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=change_this_to_a_strong_random_string_at_least_32_chars
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=900000

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (optional)
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@mpj.org.mx
EMAIL_USER=
EMAIL_PASS=
